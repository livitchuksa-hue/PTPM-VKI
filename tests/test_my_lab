class TestRegisterUser(unittest.TestCase):

    def test_register_with_valid_data_returns_success(self):
        logging.info("Запуск: test_register_with_valid_data_returns_success")
        ok, err = register_user("valid_login", "Пароль1!", "Пароль1!")
        self.assertTrue(ok)
        self.assertEqual(err, "")

    def test_register_with_mismatched_passwords_returns_error(self):
        logging.info("Запуск: test_register_with_mismatched_passwords_returns_error")
        ok, err = register_user("valid_login", "Пароль1!", "Пароль2!")
        self.assertFalse(ok)
        self.assertEqual(err, "Пароль и подтверждение пароля не совпадают")

    def test_register_with_invalid_login_returns_error(self):
        logging.info("Запуск: test_register_with_invalid_login_returns_error")
        ok, err = register_user("root", "Пароль1!", "Пароль1!")
        self.assertFalse(ok)
        self.assertIn("запрещенное слово", err)

    def test_register_with_invalid_password_returns_error(self):
        logging.info("Запуск: test_register_with_invalid_password_returns_error")
        ok, err = register_user("valid_login", "short", "short")
        self.assertFalse(ok)
        self.assertIn("минимум 7 символов", err)


if __name__ == "__main__":
    unittest.main()